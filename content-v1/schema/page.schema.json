{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://chronos.local/schema/page-v1.json",
  "title":"CHRONOS Question Page v1",
  "type":"object",
  "required":["id","kind","title","question","answer","story","period","places","domains","topics","concepts","timeline","image","sources","relations"],
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
    "kind":{"const":"question_page"},
    "title":{"$ref":"#/$defs/i18n"},
    "question":{"$ref":"#/$defs/i18n"},
    "answer":{"$ref":"#/$defs/i18n"},
    "story":{"$ref":"#/$defs/i18nArray"},
    "evidence":{"$ref":"#/$defs/i18nArray"},
    "so_what":{"$ref":"#/$defs/i18n"},
    "period":{"type":"object","required":["start","end","label"],"properties":{"start":{"type":"number"},"end":{"type":"number"},"label":{"$ref":"#/$defs/i18n"}}},
    "places":{"type":"array","items":{"type":"string"}},
    "domains":{"type":"array","items":{"type":"string"}},
    "entities":{"type":"array","items":{"type":"string"}},
    "topics":{"type":"array","items":{"type":"string"}},
    "concepts":{"type":"array","items":{"type":"string"}},
    "timeline":{"type":"object","required":["layer","importance"],"properties":{"layer":{"type":"string"},"importance":{"type":"integer","minimum":1,"maximum":5}}},
    "image":{"type":"object","required":["query"],"properties":{"query":{"type":"string"},"preferred_sources":{"type":"array","items":{"type":"string"}}}},
    "layers":{"type":"array","items":{"type":"object","required":["type","title","body"],"properties":{"type":{"enum":["detail","connect","source","debate"]},"title":{"$ref":"#/$defs/i18n"},"body":{"$ref":"#/$defs/i18n"},"sources":{"type":"array","items":{"type":"string"}}}}},
    "claims":{"type":"array","description":"Optional claim-level evidence map for high-stakes or disputed statements.","items":{"type":"object","required":["id","text","confidence","sources"],"properties":{"id":{"type":"string"},"text":{"$ref":"#/$defs/i18n"},"confidence":{"enum":["established","strong","debated","uncertain"]},"sources":{"type":"array","items":{"type":"string"}}}}},
    "sources":{"type":"array","items":{"type":"string"}},
    "relations":{"type":"array","items":{"type":"object","required":["type","target"],"properties":{"type":{"enum":["causes","contributes_to","leads_to","influences","reaction_to","same_time_as","compare_with","part_of"]},"target":{"type":"string"}}}},
    "next":{"type":["string","null"]}
  },
  "$defs":{
    "i18n":{"type":"object","required":["ja","ru"],"properties":{"ja":{"type":"string"},"ru":{"type":"string"}}},
    "i18nArray":{"type":"object","required":["ja","ru"],"properties":{"ja":{"type":"array","items":{"type":"string"}},"ru":{"type":"array","items":{"type":"string"}}}}
  }
}